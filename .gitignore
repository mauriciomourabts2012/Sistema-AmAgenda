
# ============================================================
# AMAGENDA — GITIGNORE
# Ambientes: DEV e PRODUCAO
# ============================================================

# 1. Configuracoes locais e credenciais
.env
.env.*
!.env.example
/backend/_config/conexao.php
/backend/_config/conexao.local.php
/backend/_config/twilio.php
/backend/_config/mercado_pago.php

# 2. Logs e arquivos de diagnostico
*.log
*.log.*
php_errors

# 3. Uploads e arquivos enviados pelos usuarios

# Estrutura centralizada de uploads: empresas, usuários e clientes.
# .gitkeep e .htaccess preservam a estrutura e a proteção em novas instalações.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess

# Caminhos legados mantidos somente para leitura compatível.
# Fotos de usuarios internos
/public/imagens/usuarios/*

# Fotos de clientes
/public/imagens/clientes/*

# 4. Arquivos temporarios da identidade visual
/storage/identidade-visual/temporarios/*
!/storage/identidade-visual/temporarios/.gitkeep

# 5. Arquivos temporarios
/tmp/
/temp/
*.tmp
*.temp
*.cache

# 6. Backups e dumps de banco
*.bak
*.backup
*.orig
*.sql.gz
*.sql.zip
*.dump

# 7. Dependencias e artefatos de ferramentas
/vendor/
/node_modules/
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# 8. Editores e arquivos do sistema operacional
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini


